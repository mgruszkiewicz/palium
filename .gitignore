*.xcuserstate
# project.xcworkspace/ is deliberately not ignored: it holds Package.resolved,
# which pins Sparkle to an exact revision for release builds. The xcuserdata/
# rule below still covers the per-user noise inside it.
xcuserdata/

# Generated files
*.o
*.pyc

